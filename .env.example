# HelixCode – Environment Variables
# Copy this file to .env and fill in the values you need.

# --- Provider Selection ---
# Which LLM provider to use: openai | deepseek | custom
# If unset, defaults to openai (or deepseek if HELIX_BASE_URL contains "deepseek.com").
HELIX_PROVIDER=openai

# --- API Keys ---
# General API key used as a fallback for all providers.
# For openai/custom providers the search order is: HELIX_API_KEY → OPENAI_API_KEY → DEEPSEEK_API_KEY.
# For deepseek provider the search order is:      DEEPSEEK_API_KEY → HELIX_API_KEY → OPENAI_API_KEY.
HELIX_API_KEY=sk-your-key-here

# Provider-specific keys (set the one that matches your HELIX_PROVIDER).
OPENAI_API_KEY=sk-your-openai-key-here
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# --- Model ---
# Override the model name. HELIX_CHAT_MODEL takes precedence over the legacy HELIX_MODEL.
# Default per provider: openai → gpt-4o | deepseek → deepseek-chat.
HELIX_CHAT_MODEL=gpt-4o
# HELIX_MODEL=gpt-4o

# --- Base URL ---
# Override the API base URL (useful for proxies, custom endpoints, or other OpenAI-compatible servers).
# Default per provider: openai → https://api.openai.com/v1 | deepseek → https://api.deepseek.com.
HELIX_BASE_URL=https://api.openai.com/v1

# --- Web search (optional) ---
# Bing Web Search API key. When set, web_search uses the official API; otherwise HTML scraping is used.
# HELIX_BING_API_KEY=your-bing-api-key
