# HelixCode environment configuration
# Copy this file to .env and fill in your values

# --- LLM Provider (OpenAI-compatible) ---
HELIX_LLM_API_KEY=sk-your-api-key-here
HELIX_LLM_BASE_URL=https://api.openai.com/v1
HELIX_LLM_CHAT_MODEL=gpt-4o
HELIX_LLM_EMBEDDING_MODEL=text-embedding-3-small
HELIX_LLM_MAX_TOKENS=4096
HELIX_LLM_TEMPERATURE=0.7

# --- Storage ---
HELIX_STORAGE_DATABASE_URL=sqlite+aiosqlite:///helixcode.db

# --- Qdrant Vector Database ---
HELIX_QDRANT_URL=http://localhost:6333
HELIX_QDRANT_API_KEY=
HELIX_QDRANT_COLLECTION_NAME=helixcode_code

# --- Logging ---
HELIX_LOG_LEVEL=INFO
